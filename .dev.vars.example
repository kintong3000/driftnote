# 复制为 .dev.vars 后填写（已被 git 忽略，不会提交）。
# 用于本地调试（npx wrangler dev）和 npm run setup:notion。线上环境用 npx wrangler secret put 设置同名配置。
NOTION_API_KEY=
NOTION_PARENT_PAGE=
AUTH_TOKEN=
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
MY_TG_USER_ID=
# 网页抓取，不填则不抓取、不生成摘要
FIRECRAWL_API_KEY=

# 以下三项由 npm run setup:notion 自动填写
NOTION_ENTRIES_DS=
NOTION_DAILY_DS=
NOTION_WEEKLY_DS=
